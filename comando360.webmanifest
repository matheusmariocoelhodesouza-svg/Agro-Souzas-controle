{
  "id": "./",
  "name": "Comando 360",
  "short_name": "Comando 360",
  "description": "Gestão completa da empresa: equipes, ponto, operações, frota, manutenção, abastecimento, financeiro e BI",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0b1830",
  "theme_color": "#1976d2",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./agro-souzas-controle-192-v6.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./agro-souzas-controle-512-v6.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./agro-souzas-controle-512-v6.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./comando360-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".gif"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Importar granjas do WhatsApp",
      "short_name": "Importar granjas",
      "description": "Importar produtores, cidades e localizações a partir de uma conversa exportada do WhatsApp",
      "url": "./importar-granjas.html",
      "icons": [
        {
          "src": "./agro-souzas-controle-192-v6.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Boletos DDA",
      "short_name": "DDA",
      "description": "Abrir captura automática de boletos e contas a pagar",
      "url": "./dda.html",
      "icons": [
        {
          "src": "./agro-souzas-controle-192-v6.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
